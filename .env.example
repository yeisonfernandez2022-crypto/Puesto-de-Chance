# ===========================================================
# Puesto de Chance API - Variables de entorno de ejemplo
# Copie este archivo como ".env" y ajuste los valores:
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux / macOS:        cp .env.example .env
# ===========================================================

# --- Servidor -------------------------------------------------
# Puerto HTTP donde escucha la API
PORT=3000

# Entorno de ejecución: development | production | test
NODE_ENV=development

# --- Seguridad / JWT ------------------------------------------
# Secreto para firmar los tokens JWT (¡cámbielo en producción!)
JWT_SECRET=cambiar-este-secreto

# Tiempo de vida del token JWT (formato ms de jsonwebtoken)
JWT_EXPIRES_IN=8h

# --- Localización ---------------------------------------------
# Zona horaria usada para fechas de venta, caja y sorteos
ZONA_HORARIA=America/Bogota

# --- Reglas de negocio ----------------------------------------
# Minutos posteriores a la venta en los que se puede anular un tiquete
MINUTOS_ANULACION=10

# Minutos antes del sorteo en los que se cierra la venta de tiquetes
MINUTOS_CIERRE_VENTAS=15

# Valor mínimo y máximo de cada apuesta de chance (COP)
APUESTA_MIN_CHANCE=500
APUESTA_MAX_CHANCE=50000

# Valor fijo de cada jugada de Baloto (COP)
VALOR_BALOTO=5700

# Días que tiene el cliente para cobrar un premio antes de caducar
DIAS_CADUCIDAD_PREMIO=365
